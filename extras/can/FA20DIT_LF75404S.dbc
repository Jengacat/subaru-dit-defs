CM_ SG_ 321 engine_speed_filtered "RAM FFF8B740; inferred; Filtered engine speed (CE9C, weight B73E); with an AT it tracks the TCM speed FFF8924E (0x149); 0 when FFF88A28 b1 clear or engine not rotating";
CM_ SG_ 321 pedal_flag_88C64b4 "RAM FFF8A8A9 b1 <- FFF88C64 b4; unknown; Copy of FFF88C64 b4 (pedal module 0x09F282, not decoded)";
CM_ SG_ 321 gear_mt "RAM FFF8A8AA b0-2 <- FFF88FCE; read; Gear 1..6 as binary; 7 when neutral (FFF88ADA b6); hold otherwise; 0 when not MT";
