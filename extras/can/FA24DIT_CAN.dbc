CM_ BO_ 64 "Engine speed and accelerator pedal. ID read from the checksum seed.";
CM_ SG_ 64 Checksum "Sum of bytes 1-7 + ID low byte + ID high byte, low 8 bits (read: 0x31BA28)";
CM_ SG_ 64 Counter "Rolling counter";
CM_ SG_ 64 Engine_Speed "read: FEF0662C, 1 rpm/bit";
CM_ SG_ 64 Byte4_Value "FEF066B6 (FEF09E86 / 257); meaning not read";
CM_ SG_ 64 Byte5_Value "FEF065E2 (high byte of FEF053D0); meaning not read";
CM_ SG_ 64 Accelerator_Pedal "FEF066EA, high byte of the pedal value; scale not read (raw)";
CM_ BO_ 65 "Torque values. ID read from the checksum seed.";
CM_ SG_ 65 Checksum "Sum of bytes 1-7 + ID low byte + ID high byte, low 8 bits (read: 0x31BA28)";
CM_ SG_ 65 Counter "Rolling counter";
CM_ SG_ 65 Engine_Torque "FEF06682; N.m x 10 + 10000 (read from the packer formula)";
CM_ SG_ 65 Torque_Value_2 "FEF065CC, same 10000 offset; meaning not read";
CM_ SG_ 65 Byte6_Value "FEF0662B; meaning not read";
CM_ BO_ 129 "ID read from the checksum seed.";
CM_ SG_ 129 Checksum "Sum of bytes 1-7 + ID low byte + ID high byte, low 8 bits (read: 0x31BA28)";
CM_ SG_ 129 Counter "Rolling counter";
CM_ SG_ 129 Ignition_Timing_Fired "FEF0498C, ignition timing actually fired, 0.5 deg BTDC per bit (scale as in the definitions)";
CM_ SG_ 129 Byte4_Value "FEF04A0B; meaning not read";
CM_ BO_ 326 "ID read from the checksum seed.";
CM_ SG_ 326 Checksum "Sum of bytes 1-7 + ID low byte + ID high byte, low 8 bits (read: 0x31BA28)";
CM_ SG_ 326 Value_16 "FEF03E54; meaning not read";
CM_ SG_ 326 Byte4_Value "FEF09E24 x 51 / 5120; meaning not read";
CM_ BO_ 576 "ID read from the checksum seed.";
CM_ SG_ 576 Checksum "Sum of bytes 1-7 + ID low byte + ID high byte, low 8 bits (read: 0x31BA28)";
CM_ SG_ 576 Counter "Rolling counter";
CM_ SG_ 576 Byte7_Value "FEF0A1A4 / 257; meaning not read";
CM_ BO_ 577 "ID read from the checksum seed.";
CM_ SG_ 577 Checksum "Sum of bytes 1-7 + ID low byte + ID high byte, low 8 bits (read: 0x31BA28)";
CM_ SG_ 577 Fuel_Flow_Value "FEF06630, a fuel-flow style value from rpm and an accumulator; scale not read";
CM_ BO_ 834 "ID read from the checksum seed. Only the checksum is packed here.";
CM_ SG_ 834 Checksum "Sum of bytes 1-7 + ID low byte + ID high byte, low 8 bits (read: 0x31BA28)";
CM_ BO_ 837 "ID read from the checksum seed.";
CM_ SG_ 837 Checksum "Sum of bytes 1-7 + ID low byte + ID high byte, low 8 bits (read: 0x31BA28)";
CM_ SG_ 837 Temperature_1 "FEF0A796 - 10; degC + 40 encoding inferred";
CM_ SG_ 837 Temperature_2 "FEF0A6DB - 10; degC + 40 encoding inferred";
CM_ SG_ 837 Baro_Value "(5 x FEF09BB6 >> 9) - 33; barometric pressure, scale not settled";
CM_ BO_ 838 "ID read from the checksum seed.";
CM_ SG_ 838 Checksum "Sum of bytes 1-7 + ID low byte + ID high byte, low 8 bits (read: 0x31BA28)";
CM_ SG_ 838 Value_16 "FEF0665E; meaning not read";
CM_ BO_ 839 "ID read from the checksum seed. Hours counter and battery-sensor data (inferred).";
CM_ SG_ 839 Checksum "Sum of bytes 1-7 + ID low byte + ID high byte, low 8 bits (read: 0x31BA28)";
CM_ BO_ 313 "Received; decoded by 0x318DFE.";
CM_ SG_ 313 Checksum "Assumed same rule as the transmit frames; the receive-side check is not read";
CM_ SG_ 313 Counter "Rolling counter (assumed from the transmit frames)";
CM_ SG_ 313 Vehicle_Speed "read: the ECU converts it to whole km/h with x 3686/65536";
CM_ BO_ 314 "Received; which wheel is which is not read.";
CM_ SG_ 314 Checksum "Assumed same rule as the transmit frames; the receive-side check is not read";
CM_ SG_ 314 Counter "Rolling counter (assumed from the transmit frames)";
CM_ SG_ 314 Wheel_Speed_1 "scale inferred: same correction as vehicle speed";
CM_ BO_ 315 "Received; the torque-intervention pair (inferred).";
CM_ SG_ 315 Checksum "Assumed same rule as the transmit frames; the receive-side check is not read";
CM_ SG_ 315 Counter "Rolling counter (assumed from the transmit frames)";
CM_ SG_ 315 Torque_Value_A "consumers subtract 10000; N.m x 10 inferred; default 10000";
CM_ SG_ 315 Torque_Value_B "default 14080; scale inferred";
CM_ BO_ 72 "Received. Probably absent on the manual car (inferred).";
CM_ SG_ 72 Checksum "Assumed same rule as the transmit frames; the receive-side check is not read";
CM_ SG_ 72 Counter "Rolling counter (assumed from the transmit frames)";
CM_ SG_ 72 Idle_Speed_Request "read: compared with engine speed by the idle state machine";
CM_ BO_ 722 "Received; sender inferred.";
CM_ SG_ 722 AC_Value_2 "scales the A/C adder to Decel Fuel Cut Resume RPM; raw";
CM_ SG_ 722 AC_Value "axis of Radiator Fan Duty (A/C); raw";
CM_ BO_ 280 "Received; meaning inferred from FA20 0x370.";
CM_ SG_ 280 Electrical_Load_Value "input of Idle Air Adder (CAN Load Value); raw";
CM_ BO_ 912 "Received; sender inferred.";
CM_ SG_ 912 Meter_Value "axis of the Target Torque Rise Path B low-speed times; raw";
